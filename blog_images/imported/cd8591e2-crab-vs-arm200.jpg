<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 6 18 18M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button><h2 id=bfx-cookie-banner-title class=bfx-cookie-banner__title>You&rsquo;re a smart cookie.</h2><div id=bfx-cookie-banner-desc><p class=bfx-cookie-banner__body>We use cookies to improve your experience and tailor content to your preferences on our website. However, we also respect your privacy and give you the choice to control how we use cookies. Please select your cookie preferences.</p><p class=bfx-cookie-banner__body>Your consent and the cookie policy apply to all websites of &ldquo;https://borisfx.com/&rdquo;.</p></div><div class=bfx-cookie-banner__actions><button type=button class="bfx-cookie-banner__btn bfx-cookie-banner__btn--secondary" data-cf-action=settings>Cookie Settings</button>
<button type=button class="bfx-cookie-banner__btn bfx-cookie-banner__btn--primary" data-cf-action=accept>Accept Cookies</button></div></div><style>#cookiefirst-root,#cf-root,.cf-root,.cookiefirst-banner-root,#cf-floating-button,[id^=cookiefirst-banner]:not(#bfx-cookie-banner){display:none!important}.bfx-cookie-banner{position:fixed;bottom:24px;left:24px;z-index:9999;width:520px;max-width:calc(100vw - 32px);box-sizing:border-box;padding:24px;background:#fff;border:1px solid #d0d0d0;border-radius:24px;box-shadow:0 8px 24px rgba(0,0,0,.12);font-family:golos text,proxima-nova,sans-serif;opacity:0;transform:translateY(8px);transition:opacity 200ms ease-out,transform 200ms ease-out}.bfx-cookie-banner.is-visible{opacity:1;transform:translateY(0)}.bfx-cookie-banner[hidden]{display:none}.bfx-cookie-banner__close{position:absolute;top:24px;right:24px;width:24px;height:24px;padding:0;background:0 0;border:0;color:#000;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}.bfx-cookie-banner__close:focus-visible{outline:2px solid #0baeff;outline-offset:2px;border-radius:4px}.bfx-cookie-banner__title{margin:0 32px 8px 0;font-size:16px;line-height:24px;font-weight:600;color:#000}.bfx-cookie-banner__body{margin:0 0 8px;font-size:14px;line-height:17px;font-weight:400;color:rgba(0,0,0,.65)}.bfx-cookie-banner__body:last-child{margin-bottom:0}.bfx-cookie-banner__actions{display:flex;align-items:center;gap:12px;margin-top:24px}.bfx-cookie-banner__btn{font-family:inherit;font-size:16px;line-height:20px;font-weight:500;border-radius:6px;cursor:pointer;border:0;color:rgba(0,0,0,.87)}.bfx-cookie-banner__btn--secondary{background:0 0;padding:4px}.bfx-cookie-banner__btn--secondary:hover{text-decoration:underline}.bfx-cookie-banner__btn--primary{background:#0baeff;padding:10px 16px;height:40px}.bfx-cookie-banner__btn--primary:hover{background:#00a0f0}.bfx-cookie-banner__btn:focus-visible{outline:2px solid #0baeff;outline-offset:2px}@media(max-width:540px){.bfx-cookie-ban