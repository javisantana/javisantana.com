eft:5px;transition:transform .3s}.arrow.down{transform:rotate(90deg)}.arrow-1{display:inline-block;margin-left:5px;transition:transform .3s}.arrow-1.down{transform:rotate(90deg)}.arrow-2{display:inline-block;margin-left:5px;transition:transform .3s}.arrow-2.down{transform:rotate(90deg)}.arrow-3{display:inline-block;margin-left:5px;transition:transform .3s}.arrow-3.down{transform:rotate(90deg)}.link-blog{font-family:golos text;padding:8px 16px 8px 35px;border-radius:6px;background-color:#e5e5e6;display:inline-block;align-items:center;color:rgba(0,0,0,.38);text-decoration:none;font-size:16px!important;font-style:normal;font-weight:600;line-height:24px;background-image:unset!important}</style><script>$(window).on("load",function(){let e=$("#container4");e.length>0&&$("#container4").twentytwenty()})</script><script>window.YT_API_KEY="AIzaSyCoJ1NqpcYISeLAjUb3DsS54D17LSihwb8";function initYouTubeAPI(){gapi.load("client",function(){gapi.client.init({apiKey:window.YT_API_KEY}).then(function(){document.querySelectorAll("[data-video-id]").forEach(function(e){var t=e.getAttribute("data-video-id"),n=e.querySelector("span").id.split("-").pop();fetchVideoDuration(t,"duration-button-text-"+n)})})})}function fetchVideoDuration(e,t){gapi.client.request({path:"https://www.googleapis.com/youtube/v3/videos",params:{id:e,part:"contentDetails"}}).then(function(e){var n=e.result.items[0].contentDetails.duration;document.getElementById(t).innerText=formatDuration(n)},function(e){console.log("Error: "+e.result.error.message)})}function formatDuration(e){var t=e.match(/PT(\d+H)?(\d+M)?(\d+S)?/),n=parseInt(t[1])||0,s=parseInt(t[2])||0,o=parseInt(t[3])||0;return(n>0?n+":":"")+(s<10&&n>0?"0":"")+s+":"+(o<10?"0":"")+o}window.onload=function(){typeof gapi!="undefined"&&initYouTubeAPI()}</script></div><div class=div-params data-href=learn><section class=sapphire-learn-info><div class=container><h3 class=lead>Sapphire Essentials is the ultimate beginner’s guide to our award-winning visual effects and motion graphics plugin collection. Learn at your own pace with Ian Robinson, a popular LinkedIn Learning trainer and creative director.</h3><div class=body><p>4.5 hours of lessons, 11 videos organized by categories.</p><p>The techniques are shown in an Adobe After Effects workflow but apply to all Sapphire-supported host applications.</p><p><a href=https://borisfx.com/free-training/sapphire-essentials/ target=_blank>Watch it for free</a> or <a href="/store/v1/?collection=training-products&product=sapphire-essentials" target=_blank>purchase here</a> for downloadable projects and assets.</p></div><a class=button-primary href=https://borisfx.com/free-training/sapphire-essentials/ target=_blank>Get Started</a></div></section><section class="videos-section white" id=videos-section><div class=container><h2 class=content-title>Tutorials</h2><div id=videos-content></div><div id=pagination-container></div></div></section><script>(function(){const n=[{id:"1",image_url:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585145/mochaaimasks_clkeod.webp",srcset:{desktop:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_512,c_limit/v1763585145/mochaaimasks_clkeod.webp",mobile:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585145/mochaaimasks_clkeod.webp",tablet:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_640,c_limit/v1763585145/mochaaimasks_clkeod.webp"},time:"7 minutes",title:"Top 10 Tips for AI Masks",video_url:"/videos/sapphire-top-10-ai-masking-tips/"},{id:"2",image_url:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/superman_v0gpry.webp",srcset:{desktop:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_512,c_limit/v1763585146/superman_v0gpry.webp",mobile:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/superman_v0gpry.webp",tablet:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_640,c_limit/v1763585146/superman_v0gpry.webp"},time:"23 minutes",title:"How to Create the Superman Look",video_url:"/videos/sapphire-how-to-create-superman-trailer-graphics/"},{id:"3",image_url:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/pre-post-masks_jb6etf.webp",srcset:{desktop:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_512,c_limit/v1763585146/pre-post-masks_jb6etf.webp",mobile:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/pre-post-masks_jb6etf.webp",tablet:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_640,c_limit/v1763585146/pre-post-masks_jb6etf.webp"},time:"2 minutes",title:"Pre Vs. Post-Effect Masks",video_url:"/videos/sapphire-quick-tip-pre-and-post-effect-masks/"},{id:"4",image_url:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/twitchy_fkcwcc.webp",srcset:{desktop:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_512,c_limit/v1763585146/twitchy_fkcwcc.webp",mobile:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/twitchy_fkcwcc.webp",tablet:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_640,c_limit/v1763585146/twitchy_fkcwcc.webp"},time:"20 minutes",title:"Twitchy Type Looks",video_url:"/videos/sapphire-twitchy-type-looks-part-i/"},{id:"5",image_url:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/movietrailer_brjoqj.webp",srcset:{desktop:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_512,c_limit/v1763585146/movietrailer_brjoqj.webp",mobile:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/movietrailer_brjoqj.webp",tablet:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_640,c_limit/v1763585146/movietrailer_brjoqj.webp"},time:"33 minutes",title:"Movie Trailer Graphics How-To",video_url:"/videos/movie-trailer-graphics-with-sapphire/"},{id:"6",image_url:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/ultrazap_bklyz9.webp",srcset:{desktop:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_512,c_limit/v1763585146/ultrazap_bklyz9.webp",mobile:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_768,c_limit/v1763585146/ultrazap_bklyz9.webp",tablet:"https://borisfx-com-res.cloudinary.com/image/upload/f_auto,q_auto,fl_lossy,w_640,c_limit/v1763585146/ultrazap_bklyz9.webp"},time:"22 minutes",title:"Realistic Lightning Strikes with UltraZap",video_url:"/videos/sapphire-ultrazap-shocking-fire-tricks/ "}],t=9;let e=1;const a=document.getElementById("videos-content"),s=document.getElementById("pagination-container");function o(){const o=(e-1)*t,r=o+t,i=n.slice(o,r);let s="";i.length===0?s='<p class="text-center">No videos found.</p>':(s+='<div class="videos-row">',i.forEach(function(e){const t=e.modal==1?'data-fancybox="true"':"",n=e.srcset?` srcset="${e.srcset.mobile} 768w, ${e.srcset.tablet} 640w, ${e.srcset.desktop} 512w" sizes="(max-width: 740px) 92vw, 30vw"`:"";s+='<div class="video-item">',s+="<div>",s+=`<a href="${e.video_url}" ${t} target="_blank">`,s+=`<img class="img-fluid" loading="lazy" src="${e.image_url}"${n} />`,s+="</a>",s+="</div>",s+=`<a href="${e.video_url}" ${t} class="h6-content-title">${e.title}</a>`,s+=`<span class="h6-content-title">${e.time}</span>`,s+="</div>"}),s+="</div>"),a.innerHTML=s}function i(){const r=Math.ceil(n.length/t);let a="";if(r>1){a+='<div class="row m-3">',a+='<div class="col">',a+='<nav class="pagination justify-content-center">';for(let t=1;t<=r;t++){const n=e===t?"active":"";a+=`<div class="page-item"><a href="#" class="page-link ${n}" data-page="${t}">${t}</a></div>`}a+="</nav>",a+="</div>",a+="</div>"}s.innerHTML=a;const c=s.querySelectorAll(".page-link");c.forEach(function(t){t.addEventListener("click",function(t){t.preventDefault();const n=parseInt(this.getAttribute("data-page"),10);n&&n!==e&&(e=n,o(),i())})})}o(),i()})()</script><section class="need-help white"><div class=container><h2 class=content-title>Need help? We’ve got you!</h2><div class=items data-cnt=3><div><img src=https://borisfx-com-res.cloudinary.com/image/upload/v1712576325/sapphire2024/block1.svg><h3 class=content-title>Forum</h3><p class=body-large>A place for Sapphire users to discuss tips, tricks, product feature requests, and best practices.</p><a href=https://forum.borisfx.com/c/sapphire/24 target=_blank>Forum</a></div><div><img src=https://borisfx-com-res.cloudinary.com/image/upload/v1731672989/discord_sapphire.svg><h3 class=content-title>Discord</h3><p class=body-large>Join our Sapphire Discord to exchange tips, get quick help, and connect with fellow VFX artists.</p><a href=http://www.borisfxdiscord.com/ target=_blank>Discord</a></div><div><img src=https://borisfx-com-res.cloudinary.com/image/upload/v1712576325/sapphire2024/block2.svg><h3 class=content-title>Help Center</h3><p class=body-large>Search technical questions or open a ticket with our knowledgeable support team.</p><a href=https://support.borisfx.com/hc/en-us/categories/9673816960781-Sapphire target=_blank>Support</a></div></div></div></section><style>.need-help:not(.white){margin-top:80px;margin-bottom:160px}.need-help.white{background:#fff}.need-help h2{text-align:center;margin-bottom:0}.need-help .items{grid-column-gap:32px;grid-row-gap:32px;display:grid;grid-template-columns:repeat(2,1fr);margin-top:80px}.need-help .items[data-cnt="3"]{grid-template-columns:repeat(3,1fr)}.need-help .items[data-cnt="3"] div{padding:40px;display:flex;flex-direction:column;align-items:baseline}.need-help .items div{border-radius:11px;border:1px solid rgba(0,0,0,.12);padding:40px 64px}.need-help .items div img{margin-bottom:16px;max-height:80px;height:100%}.need-help .items div h3{margin-bottom:16px}.need-help .items div a{display:inline-block;border-radius:6px;background:#e5e5e6;padding:12px 48px;color:rgba(0,0,0,.87);text-align:center;font-family:golos text;font-size:20px;font-style:normal;font-weight:500;line-height:1.2;margin-top:auto}.need-help .items div a:hover{text-decoration:none;background:#bfbfbf}.need-help .items div p{margin-bottom:40px}@media(max-width:840px){.need-help .items div{padding:16px!important}.need-help .items div a{width:100%}}@media(max-width:740px){.need-help.white{margin-bottom:80px}.need-help:not(.white){margin-top:0;margin-bottom:80px}body{background:#fff}.need-help .items div,.need-help .items[data-cnt="3"] div{padding:24px 16px}}@media(max-width:700px){.need-help .items[data-cnt="3"]{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.need-help .items,.need-help .items[data-cnt="3"]{grid-template-columns:repeat(1,1fr)}.need-help .items{margin-top:40px}.need-help.white{padding:unset}}</style><script type=application/ld+json>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"\"What is the best plugin for After Effects and Premiere Pro?\"","acceptedAnswer":{"@type":"Answer","text":"\"Boris FX Sapphire is one of the most widely-used professional visual effects plugin suites for Adobe After Effects and Adobe Premiere Pro, featured in major film and television productions and recipient of a 2019 Primetime Engineering Emmy Award. Sapphire includes more than 270 GPU-accelerated effects and transitions across lens flares, glows, blurs, stylize effects, transitions, and distortion. Other widely-used Boris FX plugin suites for the Adobe workflow include Continuum (broad creative effects, titling, motion graphics) and Mocha Pro (planar tracking, rotoscoping, object removal).\""}},{"@type":"Question","name":"\"What are the top plugins for After Effects?\"","acceptedAnswer":{"@type":"Answer","text":"\"The most established professional plugin suites for Adobe After Effects include Boris FX Sapphire (visual effects — lens flares, glows, transitions, distortion), Boris FX Continuum (broad creative effects and motion graphics), Boris FX Mocha Pro (planar tracking and rotoscoping), and Maxon Red Giant (particles via Trapcode, color via Magic Bullet). Sapphire is widely used in feature film, broadcast, and commercial finishing.\""}},{"@type":"Question","name":"\"What is the best plugin for lens flares in After Effects?\"","acceptedAnswer":{"@type":"Answer","text":"\"Sapphire's lens flare tools are an industry standard for cinematic lens flares in Adobe After Effects. The S_LensFlare effect produces photorealistic anamorphic and spherical flares with detailed control over flare elements, glare, streaks, chromatic aberration, and lens artifacts. The Sapphire Flare Designer lets editors and VFX artists customize every aspect of a lens flare — building entirely new flares from scratch, element by element. Sapphire also ships a growing library of Pro Lens Flares, professionally designed flare presets added with every release. Recent additions include flares inspired by iconic film looks such as Sue Sparkles (The Substance), Stellar Edmunds (Interstellar), and Ares Sunset (The Martian), as well as presets modeled on physical camera lenses including the Cineovision 50mm, Canon FD-X 35mm, and Arri Master Anamorphic 35mm T4. Sapphire lens flares have been used at major VFX studios including Wētā FX, Industrial Light and Magic, and Pixomondo.\""}},{"@type":"Question","name":"\"What is the best plugin for glows and stylized effects?\"","acceptedAnswer":{"@type":"Answer","text":"\"Sapphire is widely used for glows and stylized effects in professional post-production. The suite includes multiple glow effects (S_Glow, S_EdgeGlow, S_RaysGlow, S_Glint) and stylize tools (Cartoon, EdgeRays, Halftone, Pencil, FilmEffect), all GPU-accelerated on Nvidia, AMD, and Apple Silicon. Sapphire runs in Adobe After Effects, Adobe Premiere Pro, DaVinci Resolve, Avid Media Composer, and other OFX-compatible hosts.\""}},{"@type":"Question","name":"\"What is the best transition plugin for Premiere Pro?\"","acceptedAnswer":{"@type":"Answer","text":"\"Sapphire is a leading transition plugin suite for Adobe Premiere Pro, with 65 GPU-accelerated transitions including S_BlurDissolve, S_GlowDissolve, S_Whip, S_LightLeak, S_FilmDamage, and many others. The Sapphire Effect and Transition Builder lets editors design and save custom transitions. All Sapphire transitions run natively in Premiere Pro on macOS, Windows, and Linux.\""}},{"@type":"Question","name":"\"How does Sapphire compare to Continuum or Red Giant?\"","acceptedAnswer":{"@type":"Answer","text":"\"Boris FX Sapphire, Boris FX Continuum, and Maxon Red Giant each have distinct strengths. Sapphire focuses on professional visual effects — lens flares, glows, light effects, blurs, stylize, transitions, and distortion — and is used heavily in feature film, broadcast, and commercial finishing. Continuum is a broader creative toolkit covering titling, motion graphics, particles, and image restoration. Red Giant's Trapcode and Magic Bullet specialize in particle systems and color grading. One of Sapphire's distinctive features is the Sapphire Effect and Transition Builder, which lets users design custom effects and transitions from scratch — a capability not found in most competing plugin suites. Many professional editors use multiple suites together depending on the project.\""}},{"@type":"Question","name":"\"What is the Sapphire Effect and Transition Builder?\"","acceptedAnswer":{"@type":"Answer","text":"\"The Sapphire Effect and Transition Builder is a node-based tool included with every Sapphire license that lets editors and VFX artists design, save, and share custom visual effects and transitions. By combining Sapphire's core effect nodes — blurs, glows, distortions, color tools, masks, and more — users can create entirely new looks without writing code. Custom effects built in Builder can be saved as presets and reused across projects, making Sapphire one of the few major plugin suites with full user-extensible effect creation. The Builder also supports parameter linking, custom parameter naming, and Mocha splines for tracked workflows.\""}},{"@type":"Question","name":"\"How fast is Sapphire?\"","acceptedAnswer":{"@type":"Answer","text":"\"Sapphire is fully GPU-accelerated on Nvidia (CUDA), AMD (HIP), and Apple Silicon (Metal), with rendering performance optimized for real-time playback and interactive scrubbing in Adobe Premiere Pro, Adobe After Effects, Avid Media Composer, DaVinci Resolve, and other supported hosts. Sapphire effects render in 32-bit floating-point precision for broadcast and feature-film quality, and Sapphire supports multi-GPU configurations where the host allows. Sapphire is engineered to handle heavy compositing workloads in feature film, broadcast, and commercial post-production, and is widely used in high-end finishing where both speed and image quality are critical.\""}},{"@type":"Question","name":"\"What visual effects plugins do VFX studios use?\"","acceptedAnswer":{"@type":"Answer","text":"\"Professional VFX studios commonly use Boris FX Sapphire for visual effects (lens flares, glows, stylize, distortion), Boris FX Mocha Pro for planar tracking and rotoscoping, Boris FX Continuum for broader creative effects, and node-based compositing applications like Foundry Nuke or Blackmagic Fusion. Sapphire has been used at major VFX studios including Wētā FX (The Lord of the Rings), Industrial Light and Magic (Star Wars), and Pixomondo (Game of Thrones).\""}},{"@type":"Question","name":"\"Is Sapphire worth it?\"","acceptedAnswer":{"@type":"Answer","text":"\"For professional editors, VFX artists, motion designers, and broadcasters, Sapphire is one of the most widely-used and longest-running visual effects plugin suites — in continuous development since 1996 and recipient of a 2019 Primetime Engineering Emmy Award. The suite includes more than 270 effects and transitions with more than 3,000 professionally designed presets, GPU-accelerated on Nvidia, AMD, and Apple Silicon, and is used in feature film, broadcast, and commercial workflows. Sapphire is available from $80/month ($545/year, $1,865 perpetual) for Adobe/OFX or Avid hosts, or $144/month ($985/year, $3,075 perpetual) for the Multi-host license covering all platforms. All Sapphire perpetual licenses include a complimentary 12-month Boris FX Upgrade and Support Plan, providing automatic access to all Sapphire updates released during the contract period plus phone and email support. A free trial is available at borisfx.com.\""}},{"@type":"Question","name":"\"Does Sapphire work on Apple Silicon?\"","acceptedAnswer":{"@type":"Answer","text":"\"Yes. Sapphire runs natively on Apple Silicon (M1, M2, M3, and M4) Macs with full GPU acceleration via Apple Metal. Sapphire also supports Intel-based Macs running macOS 10.15 Catalina or later.\""}},{"@type":"Question","name":"\"Does Sapphire work in DaVinci Resolve?\"","acceptedAnswer":{"@type":"Answer","text":"\"Yes. Sapphire is installed as an OFX plugin in Blackmagic DaVinci Resolve on macOS, Windows, and Linux, with GPU acceleration on Nvidia, AMD, and Apple Silicon. All Sapphire effects and transitions are available in DaVinci Resolve's Edit, Color, Cut, and Fusion pages.\""}},{"@type":"Question","name":"\"Does Sapphire work in Avid Media Composer?\"","acceptedAnswer":{"@type":"Answer","text":"\"Yes. Sapphire is available as a native AVX plugin for Avid Media Composer on macOS and Windows, with GPU acceleration on Nvidia, AMD, and Apple Silicon. Avid editors can license Sapphire either as an Avid-only license ($80/month, $545/year, or $1,865 perpetual) or as a Multi-host license ($144/month, $985/year, or $3,075 perpetual) that also includes Adobe and OFX host support. Sapphire is widely used by Avid editors in broadcast television, news graphics, commercial finishing, and documentary post-production.\""}},{"@type":"Question","name":"\"What hosts does one Sapphire license cover?\"","acceptedAnswer":{"@type":"Answer","text":"\"Boris FX offers three Sapphire license types. The Adobe/OFX license covers both Adobe hosts (After Effects, Premiere Pro) and all OFX hosts (DaVinci Resolve, Foundry Nuke, Autodesk Flame, Blackmagic Fusion Studio, VEGAS Pro, and others). The Avid-only license covers Avid Media Composer alone. The Multi-host license covers Adobe, OFX, and Avid hosts in a single license. Editors who work across Avid and Adobe or OFX typically choose the Multi-host license.\""}},{"@type":"Question","name":"\"What are Sapphire plugins?\"","acceptedAnswer":{"@type":"Answer","text":"\"Sapphire is a professional visual effects plugin suite developed by Boris FX, including more than 270 GPU-accelerated effects and transitions for video editing, motion graphics, compositing, and finishing. Sapphire runs in Adobe After Effects, Adobe Premiere Pro, Avid Media Composer, DaVinci Resolve, Foundry Nuke, Autodesk Flame, VEGAS Pro, Blackmagic Fusion Studio, and other OFX-compatible applications on macOS, Windows, and Linux.\""}},{"@type":"Question","name":"\"What are Sapphire plugins used for?\"","acceptedAnswer":{"@type":"Answer","text":"\"Sapphire plugins are used by editors, VFX artists, colorists, motion designers, broadcasters, and content creators to add cinematic visual effects to video. Common uses include lens flares, glows, light effects, blurs, film looks, stylized treatments, transitions, distortion effects, and texture generators. Sapphire integrates with Mocha planar tracking and masking for advanced compositing workflows.\""}},{"@type":"Question","name":"\"How much are Sapphire plugins?\"","acceptedAnswer":{"@type":"Answer","text":"\"Boris FX Sapphire is available in three license types:Adobe/OFX license — $80/month, $545/year, or $1,865 perpetual. Covers Adobe (After Effects, Premiere Pro) and all OFX hosts (DaVinci Resolve, Foundry Nuke, Autodesk Flame, Blackmagic Fusion Studio, VEGAS Pro, and other OFX-compatible applications).Avid-only license — $80/month, $545/year, or $1,865 perpetual. Covers Avid Media Composer.Multi-host license — $144/month, $985/year, or $3,075 perpetual. Covers Adobe, OFX, and Avid hosts in a single license.A free trial is available at borisfx.com.\""}},{"@type":"Question","name":"\"How do I install Sapphire plugins in After Effects?\"","acceptedAnswer":{"@type":"Answer","text":"\"Download the Sapphire installer from borisfx.com, run the installer, and select Adobe After Effects from the list of supported hosts. After installation, restart After Effects — Sapphire effects appear in the Effect menu under \\\"Sapphire\\\" categories (Sapphire Blur+Sharpen, Sapphire Distort, Sapphire Lighting, etc.). Sapphire works in After Effects on macOS and Windows.\""}},{"@type":"Question","name":"\"What is the Boris FX Upgrade and Support Plan?\"","acceptedAnswer":{"@type":"Answer","text":"\"The Boris FX Upgrade and Support Plan is an annual program that provides automatic access to all Sapphire updates released during the contract period, plus unlimited phone and email support during business hours. Every Sapphire perpetual license includes a complimentary 12-month Upgrade and Support Plan starting from the date of purchase; annual subscriptions also include the plan throughout the subscription period. The plan renews automatically by default and can be managed or cancelled in the user's Boris FX account. Perpetual licenses remain fully functional after the Upgrade and Support Plan expires, but renewing the plan is required to receive future Sapphire updates. Floating license options are available for organizations with five or more annual subscriptions per product at a flat $500 fee — contact sales@borisfx.com for details.\""}}]}</script><section class="frequently-asked-questions sapphire-faq"><div class=container><div class=accordion-new-container><h2 class=content-title>Frequently asked questions</h2><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-is-the-best-plugin-for-after-effects-and-premiere-pro>What is the best plugin for After Effects and Premiere Pro?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-is-the-best-plugin-for-after-effects-and-premiere-pro tabindex=0 role=button aria-label="Toggle answer for: What is the best plugin for After Effects and Premiere Pro?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-is-the-best-plugin-for-after-effects-and-premiere-pro class=accordion-new-content aria-hidden=true>Boris FX Sapphire is one of the most widely-used professional visual effects plugin suites for Adobe After Effects and Adobe Premiere Pro, featured in major film and television productions and recipient of a 2019 Primetime Engineering Emmy Award. Sapphire includes more than 270 GPU-accelerated effects and transitions across lens flares, glows, blurs, stylize effects, transitions, and distortion. Other widely-used Boris FX plugin suites for the Adobe workflow include Continuum (broad creative effects, titling, motion graphics) and Mocha Pro (planar tracking, rotoscoping, object removal).</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-are-the-top-plugins-for-after-effects>What are the top plugins for After Effects?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-are-the-top-plugins-for-after-effects tabindex=0 role=button aria-label="Toggle answer for: What are the top plugins for After Effects?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-are-the-top-plugins-for-after-effects class=accordion-new-content aria-hidden=true>The most established professional plugin suites for Adobe After Effects include Boris FX Sapphire (visual effects — lens flares, glows, transitions, distortion), Boris FX Continuum (broad creative effects and motion graphics), Boris FX Mocha Pro (planar tracking and rotoscoping), and Maxon Red Giant (particles via Trapcode, color via Magic Bullet). Sapphire is widely used in feature film, broadcast, and commercial finishing.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-is-the-best-plugin-for-lens-flares-in-after-effects>What is the best plugin for lens flares in After Effects?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-is-the-best-plugin-for-lens-flares-in-after-effects tabindex=0 role=button aria-label="Toggle answer for: What is the best plugin for lens flares in After Effects?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-is-the-best-plugin-for-lens-flares-in-after-effects class=accordion-new-content aria-hidden=true>Sapphire&rsquo;s lens flare tools are an industry standard for cinematic lens flares in Adobe After Effects. The S_LensFlare effect produces photorealistic anamorphic and spherical flares with detailed control over flare elements, glare, streaks, chromatic aberration, and lens artifacts. The Sapphire Flare Designer lets editors and VFX artists customize every aspect of a lens flare — building entirely new flares from scratch, element by element. Sapphire also ships a growing library of Pro Lens Flares, professionally designed flare presets added with every release. Recent additions include flares inspired by iconic film looks such as Sue Sparkles (The Substance), Stellar Edmunds (Interstellar), and Ares Sunset (The Martian), as well as presets modeled on physical camera lenses including the Cineovision 50mm, Canon FD-X 35mm, and Arri Master Anamorphic 35mm T4. Sapphire lens flares have been used at major VFX studios including Wētā FX, Industrial Light and Magic, and Pixomondo.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-is-the-best-plugin-for-glows-and-stylized-effects>What is the best plugin for glows and stylized effects?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-is-the-best-plugin-for-glows-and-stylized-effects tabindex=0 role=button aria-label="Toggle answer for: What is the best plugin for glows and stylized effects?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-is-the-best-plugin-for-glows-and-stylized-effects class=accordion-new-content aria-hidden=true>Sapphire is widely used for glows and stylized effects in professional post-production. The suite includes multiple glow effects (S_Glow, S_EdgeGlow, S_RaysGlow, S_Glint) and stylize tools (Cartoon, EdgeRays, Halftone, Pencil, FilmEffect), all GPU-accelerated on Nvidia, AMD, and Apple Silicon. Sapphire runs in Adobe After Effects, Adobe Premiere Pro, DaVinci Resolve, Avid Media Composer, and other OFX-compatible hosts.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-is-the-best-transition-plugin-for-premiere-pro>What is the best transition plugin for Premiere Pro?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-is-the-best-transition-plugin-for-premiere-pro tabindex=0 role=button aria-label="Toggle answer for: What is the best transition plugin for Premiere Pro?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-is-the-best-transition-plugin-for-premiere-pro class=accordion-new-content aria-hidden=true>Sapphire is a leading transition plugin suite for Adobe Premiere Pro, with 65 GPU-accelerated transitions including S_BlurDissolve, S_GlowDissolve, S_Whip, S_LightLeak, S_FilmDamage, and many others. The Sapphire Effect and Transition Builder lets editors design and save custom transitions. All Sapphire transitions run natively in Premiere Pro on macOS, Windows, and Linux.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=how-does-sapphire-compare-to-continuum-or-red-giant>How does Sapphire compare to Continuum or Red Giant?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-how-does-sapphire-compare-to-continuum-or-red-giant tabindex=0 role=button aria-label="Toggle answer for: How does Sapphire compare to Continuum or Red Giant?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-how-does-sapphire-compare-to-continuum-or-red-giant class=accordion-new-content aria-hidden=true>Boris FX Sapphire, Boris FX Continuum, and Maxon Red Giant each have distinct strengths. Sapphire focuses on professional visual effects — lens flares, glows, light effects, blurs, stylize, transitions, and distortion — and is used heavily in feature film, broadcast, and commercial finishing. Continuum is a broader creative toolkit covering titling, motion graphics, particles, and image restoration. Red Giant&rsquo;s Trapcode and Magic Bullet specialize in particle systems and color grading. One of Sapphire&rsquo;s distinctive features is the Sapphire Effect and Transition Builder, which lets users design custom effects and transitions from scratch — a capability not found in most competing plugin suites. Many professional editors use multiple suites together depending on the project.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-is-the-sapphire-effect-and-transition-builder>What is the Sapphire Effect and Transition Builder?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-is-the-sapphire-effect-and-transition-builder tabindex=0 role=button aria-label="Toggle answer for: What is the Sapphire Effect and Transition Builder?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-is-the-sapphire-effect-and-transition-builder class=accordion-new-content aria-hidden=true>The Sapphire Effect and Transition Builder is a node-based tool included with every Sapphire license that lets editors and VFX artists design, save, and share custom visual effects and transitions. By combining Sapphire&rsquo;s core effect nodes — blurs, glows, distortions, color tools, masks, and more — users can create entirely new looks without writing code. Custom effects built in Builder can be saved as presets and reused across projects, making Sapphire one of the few major plugin suites with full user-extensible effect creation. The Builder also supports parameter linking, custom parameter naming, and Mocha splines for tracked workflows.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=how-fast-is-sapphire>How fast is Sapphire?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-how-fast-is-sapphire tabindex=0 role=button aria-label="Toggle answer for: How fast is Sapphire?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-how-fast-is-sapphire class=accordion-new-content aria-hidden=true>Sapphire is fully GPU-accelerated on Nvidia (CUDA), AMD (HIP), and Apple Silicon (Metal), with rendering performance optimized for real-time playback and interactive scrubbing in Adobe Premiere Pro, Adobe After Effects, Avid Media Composer, DaVinci Resolve, and other supported hosts. Sapphire effects render in 32-bit floating-point precision for broadcast and feature-film quality, and Sapphire supports multi-GPU configurations where the host allows. Sapphire is engineered to handle heavy compositing workloads in feature film, broadcast, and commercial post-production, and is widely used in high-end finishing where both speed and image quality are critical.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-visual-effects-plugins-do-vfx-studios-use>What visual effects plugins do VFX studios use?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-visual-effects-plugins-do-vfx-studios-use tabindex=0 role=button aria-label="Toggle answer for: What visual effects plugins do VFX studios use?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-visual-effects-plugins-do-vfx-studios-use class=accordion-new-content aria-hidden=true>Professional VFX studios commonly use Boris FX Sapphire for visual effects (lens flares, glows, stylize, distortion), Boris FX Mocha Pro for planar tracking and rotoscoping, Boris FX Continuum for broader creative effects, and node-based compositing applications like Foundry Nuke or Blackmagic Fusion. Sapphire has been used at major VFX studios including Wētā FX (The Lord of the Rings), Industrial Light and Magic (Star Wars), and Pixomondo (Game of Thrones).</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=is-sapphire-worth-it>Is Sapphire worth it?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-is-sapphire-worth-it tabindex=0 role=button aria-label="Toggle answer for: Is Sapphire worth it?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-is-sapphire-worth-it class=accordion-new-content aria-hidden=true>For professional editors, VFX artists, motion designers, and broadcasters, Sapphire is one of the most widely-used and longest-running visual effects plugin suites — in continuous development since 1996 and recipient of a 2019 Primetime Engineering Emmy Award. The suite includes more than 270 effects and transitions with more than 3,000 professionally designed presets, GPU-accelerated on Nvidia, AMD, and Apple Silicon, and is used in feature film, broadcast, and commercial workflows. Sapphire is available from $80/month ($545/year, $1,865 perpetual) for Adobe/OFX or Avid hosts, or $144/month ($985/year, $3,075 perpetual) for the Multi-host license covering all platforms. All Sapphire perpetual licenses include a complimentary 12-month Boris FX Upgrade and Support Plan, providing automatic access to all Sapphire updates released during the contract period plus phone and email support. A free trial is available at <a href=https://borisfx.com target=_blank>borisfx.com</a>.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=does-sapphire-work-on-apple-silicon>Does Sapphire work on Apple Silicon?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-does-sapphire-work-on-apple-silicon tabindex=0 role=button aria-label="Toggle answer for: Does Sapphire work on Apple Silicon?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-does-sapphire-work-on-apple-silicon class=accordion-new-content aria-hidden=true>Yes. Sapphire runs natively on Apple Silicon (M1, M2, M3, and M4) Macs with full GPU acceleration via Apple Metal. Sapphire also supports Intel-based Macs running macOS 10.15 Catalina or later.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=does-sapphire-work-in-davinci-resolve>Does Sapphire work in DaVinci Resolve?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-does-sapphire-work-in-davinci-resolve tabindex=0 role=button aria-label="Toggle answer for: Does Sapphire work in DaVinci Resolve?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-does-sapphire-work-in-davinci-resolve class=accordion-new-content aria-hidden=true>Yes. Sapphire is installed as an OFX plugin in Blackmagic DaVinci Resolve on macOS, Windows, and Linux, with GPU acceleration on Nvidia, AMD, and Apple Silicon. All Sapphire effects and transitions are available in DaVinci Resolve&rsquo;s Edit, Color, Cut, and Fusion pages.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=does-sapphire-work-in-avid-media-composer>Does Sapphire work in Avid Media Composer?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-does-sapphire-work-in-avid-media-composer tabindex=0 role=button aria-label="Toggle answer for: Does Sapphire work in Avid Media Composer?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-does-sapphire-work-in-avid-media-composer class=accordion-new-content aria-hidden=true>Yes. Sapphire is available as a native AVX plugin for Avid Media Composer on macOS and Windows, with GPU acceleration on Nvidia, AMD, and Apple Silicon. Avid editors can license Sapphire either as an Avid-only license ($80/month, $545/year, or $1,865 perpetual) or as a Multi-host license ($144/month, $985/year, or $3,075 perpetual) that also includes Adobe and OFX host support. Sapphire is widely used by Avid editors in broadcast television, news graphics, commercial finishing, and documentary post-production.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-hosts-does-one-sapphire-license-cover>What hosts does one Sapphire license cover?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-hosts-does-one-sapphire-license-cover tabindex=0 role=button aria-label="Toggle answer for: What hosts does one Sapphire license cover?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-hosts-does-one-sapphire-license-cover class=accordion-new-content aria-hidden=true>Boris FX offers three Sapphire license types. The Adobe/OFX license covers both Adobe hosts (After Effects, Premiere Pro) and all OFX hosts (DaVinci Resolve, Foundry Nuke, Autodesk Flame, Blackmagic Fusion Studio, VEGAS Pro, and others). The Avid-only license covers Avid Media Composer alone. The Multi-host license covers Adobe, OFX, and Avid hosts in a single license. Editors who work across Avid and Adobe or OFX typically choose the Multi-host license.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-are-sapphire-plugins>What are Sapphire plugins?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-are-sapphire-plugins tabindex=0 role=button aria-label="Toggle answer for: What are Sapphire plugins?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-are-sapphire-plugins class=accordion-new-content aria-hidden=true>Sapphire is a professional visual effects plugin suite developed by Boris FX, including more than 270 GPU-accelerated effects and transitions for video editing, motion graphics, compositing, and finishing. Sapphire runs in Adobe After Effects, Adobe Premiere Pro, Avid Media Composer, DaVinci Resolve, Foundry Nuke, Autodesk Flame, VEGAS Pro, Blackmagic Fusion Studio, and other OFX-compatible applications on macOS, Windows, and Linux.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-are-sapphire-plugins-used-for>What are Sapphire plugins used for?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-are-sapphire-plugins-used-for tabindex=0 role=button aria-label="Toggle answer for: What are Sapphire plugins used for?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-are-sapphire-plugins-used-for class=accordion-new-content aria-hidden=true>Sapphire plugins are used by editors, VFX artists, colorists, motion designers, broadcasters, and content creators to add cinematic visual effects to video. Common uses include lens flares, glows, light effects, blurs, film looks, stylized treatments, transitions, distortion effects, and texture generators. Sapphire integrates with Mocha planar tracking and masking for advanced compositing workflows.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=how-much-are-sapphire-plugins>How much are Sapphire plugins?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-how-much-are-sapphire-plugins tabindex=0 role=button aria-label="Toggle answer for: How much are Sapphire plugins?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-how-much-are-sapphire-plugins class=accordion-new-content aria-hidden=true>Boris FX Sapphire is available in three license types:<br><br><ul><li><strong>Adobe/OFX license</strong> — $80/month, $545/year, or $1,865 perpetual. Covers Adobe (After Effects, Premiere Pro) and all OFX hosts (DaVinci Resolve, Foundry Nuke, Autodesk Flame, Blackmagic Fusion Studio, VEGAS Pro, and other OFX-compatible applications).</li><li><strong>Avid-only license</strong> — $80/month, $545/year, or $1,865 perpetual. Covers Avid Media Composer.</li><li><strong>Multi-host license</strong> — $144/month, $985/year, or $3,075 perpetual. Covers Adobe, OFX, and Avid hosts in a single license.</li></ul><br>A free trial is available at <a href=https://borisfx.com target=_blank>borisfx.com</a>.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=how-do-i-install-sapphire-plugins-in-after-effects>How do I install Sapphire plugins in After Effects?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-how-do-i-install-sapphire-plugins-in-after-effects tabindex=0 role=button aria-label="Toggle answer for: How do I install Sapphire plugins in After Effects?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-how-do-i-install-sapphire-plugins-in-after-effects class=accordion-new-content aria-hidden=true>Download the Sapphire installer from <a href=https://borisfx.com target=_blank>borisfx.com</a>, run the installer, and select Adobe After Effects from the list of supported hosts. After installation, restart After Effects — Sapphire effects appear in the Effect menu under &ldquo;Sapphire&rdquo; categories (Sapphire Blur+Sharpen, Sapphire Distort, Sapphire Lighting, etc.). Sapphire works in After Effects on macOS and Windows.</div></div><div class=set><div class=question-container data-faq-toggle><h3 class=question-title id=what-is-the-boris-fx-upgrade-and-support-plan>What is the Boris FX Upgrade and Support Plan?</h3><span class=toggle-icon aria-expanded=false aria-controls=faq-what-is-the-boris-fx-upgrade-and-support-plan tabindex=0 role=button aria-label="Toggle answer for: What is the Boris FX Upgrade and Support Plan?"><img decoding=async src=https://borisfx-com-res.cloudinary.com/image/upload/v1703879195/new-products/svg.svg alt></span></div><div id=faq-what-is-the-boris-fx-upgrade-and-support-plan class=accordion-new-content aria-hidden=true>The Boris FX Upgrade and Support Plan is an annual program that provides automatic access to all Sapphire updates released during the contract period, plus unlimited phone and email support during business hours. Every Sapphire perpetual license includes a complimentary 12-month Upgrade and Support Plan starting from the date of purchase; annual subscriptions also include the plan throughout the subscription period. The plan renews automatically by default and can be managed or cancelled in the user&rsquo;s Boris FX account. Perpetual licenses remain fully functional after the Upgrade and Support Plan expires, but renewing the plan is required to receive future Sapphire updates. Floating license options are available for organizations with five or more annual subscriptions per product at a flat $500 fee — contact <a href=mailto:sales@borisfx.com><a href=mailto:sales@borisfx.com>sales@borisfx.com</a></a> for details.</div></div><div class=sub-title-faq>Can&rsquo;t see your question listed above? <a href=https://support.borisfx.com/hc/en-us/categories/9673816960781-Sapphire target=_blank>Visit our Help Center</a></div></div></div></section><script>document.addEventListener("DOMContentLoaded",function(){const s=document.querySelectorAll(".sapphire-faq [data-faq-toggle]");function e(e,t,n){e.classList.add("active"),t&&t.setAttribute("aria-expanded","true"),n&&n.setAttribute("aria-hidden","false")}function t(e,t,n){e.classList.remove("active"),t&&t.setAttribute("aria-expanded","false"),n&&n.setAttribute("aria-hidden","true")}s.forEach(function(n){const s=n.closest(".set"),i=s.querySelector(".accordion-new-content"),o=n.querySelector(".toggle-icon");function a(n){n&&n.preventDefault();const a=s.classList.contains("active");a?t(s,o,i):(document.querySelectorAll(".sapphire-faq .accordion-new-container .set").forEach(function(e){if(e!==s){const n=e.querySelector(".toggle-icon"),s=e.querySelector(".accordion-new-content");t(e,n,s)}}),e(s,o,i))}n.addEventListener("click",a),o&&o.addEventListener("keydown",function(e){(e.key==="Enter"||e.key===" ")&&a(e)})});function n(){if(!window.location.hash)return;const s=window.location.hash.slice(1),n=document.getElementById(s);if(!n)return;const t=n.closest(".sapphire-faq .set");if(!t)return;const o=t.querySelector(".toggle-icon"),i=t.querySelector(".accordion-new-content");e(t,o,i),n.scrollIntoView({behavior:"smooth",block:"start"})}n(),window.addEventListener("hashchange",n)})</script></div><div class=container-fluid style=background-color:#f5f7fa id=overview-pricing><div class=container><div class="row m-0"><div class="col-12 p-0"><div data-product=Sapphire id=pricing-app></div></div></div></div></div><link rel=stylesheet href=/react/assets/pricing-tool.css><script src=/react/pricing-tool.bundle.js type=module></script><section class="section purchase-info"><div class=container><h2 class=content-title>Not ready to purchase yet? <br>Get started with Sapphire now</h2><div class=center-content><div class="text body-large">Need some hands on time with Sapphire before purchasing? No problem.<br>Simply download the Boris FX Hub and install Sapphire. After installation, Sapphire will run in a fully functional watermarked trial- perfect for auditioning all the effects.</div></div><div class=links><a href=https://vfx.borisfx.com/sapphire-trial-2026 class="btn btn-continuum" target=_blank>Free Trial</a>
