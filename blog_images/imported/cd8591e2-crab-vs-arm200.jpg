159837 1.28793L4.61398 5.83709C4.71724 5.94262 4.8552 6.00041 5.00187 6C5.14919 6.00041 5.28699 5.9427 5.39033 5.83709L9.84016 1.29217C9.94325 1.18705 10 1.0468 10 0.897093C10 0.747467 9.94325 0.607224 9.84016 0.50202L9.51252 0.167312C9.29927 -0.0504846 8.95211 -0.0504846 8.73894 0.167312L5.00211 3.98378Z" fill="%23818181"/></svg>');background-repeat:no-repeat;background-position:100%;padding-right:15px!important;border:none;background-color:initial;max-width:max-content;color:rgba(0,0,0,.87);text-align:center;font-size:20px!important;font-style:normal;font-weight:600;line-height:32px}.ecommerce-section .form #purchase-window .qty-block .qty-div input{font-size:20px!important;font-style:normal;font-weight:600;line-height:32px;color:#000;padding:2px 5px!important;max-width:60px!important;margin-left:5px}body .ecommerce-section .need-video-link{height:40px;max-height:40px;font-family:golos text semibold;font-size:16px!important;font-style:normal;font-weight:600;line-height:24px;min-width:auto}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .price-span{display:none}@media(max-width:920px){.ecommerce-section .store-container{flex-wrap:wrap}.ecommerce-section .form{margin-left:0}}@media(max-width:740px){.ecommerce-section .store-container .text img{height:auto;width:100%;max-height:max-content;max-width:100%}.ecommerce-section .store-container{gap:64px}.ecommerce-section .form{padding:24px 16px}}@media(max-width:600px){.ecommerce-section .store-container{flex-direction:column}.ecommerce-section .form{margin-right:auto}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option{flex-direction:column}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .title{font-weight:400}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .title br{display:none}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .price-over{text-align:left;margin-top:8px;margin-left:0}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .price-span{display:inline-block}.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .price-over .price-total,.ecommerce-section .form #purchase-window .plan-pricing .plan-item div.subscription-option .price-over .price-month{display:contents;font-weight:600}}@media(max-width:550px){.ecommerce-section .store-container .text img{margin-bottom:16px}.ecommerce-section{padding:24px 0;background:#161719}}@media(max-width:370px){.ecommerce-section .form #purchase-window .add-to-cart-block .btn{padding:9px}.ecommerce-section .form{padding:24px 16px}}</style><section class=sapphire-effect-categories><div class=efc-container><h2 class=efc-title>Sapphire Effect Categories</h2><div class=efc-grid><div class=efc-card tabindex=0><div class=efc-media><img src=https://borisfx-com-res.cloudinary.com/image/upload/w_1264,c_limit,q_auto,f_auto,fl_lossy/v1712407728/sapphire2024/1.jpg alt loading=lazy decoding=async></div><div class=efc-text><h3 class=efc-card-title>Light & Flares</h3><div class=efc-card-desc>Shot missing something? Add lighting effects and beautiful lens flares.<br><br>Lens flares, rays, glows, glints, bokeh effects, streaks, light leaks, flashbulbs, and more.</div></div></div><div class=efc-card tabindex=0><div class=efc-media><img src=https://borisfx-com-res.cloudinary.com/image/upload/w_1264,c_limit,q_auto,f_auto,fl_lossy/v1712408807/sapphire2024/2.jpg alt loading=lazy decoding=async></div><div class=efc-text><h3 class=efc-card-title>Blur & Distort</h3><div class=efc-card-desc>High-quality lens distortions and photorealistic blurs.<br><br>Camera shakes, rack defocuses, lens whacking, z-blurs, edge aware blurs, beauty effects, and more.</div></div></div><div class=efc-card tabindex=0><div class=efc-media><img src=https://borisfx-com-res.cloudinary.com/image/upload/w_1264,c_limit,q_auto,f_auto,fl_lossy/v1712408960/sapphire2024/3.jpg alt loading=lazy decoding=async></div><div class=efc-text><h3 class=efc-card-title>Render & Composite</h3><div class=efc-card-desc>Deep & fast tools to adjust your shots and build better comps by adding new textures and elements.<br><br>Zaps, textures, caustics, starfields, gradients, sparkles, grunges, auroras, and more.</div></div></div><div class=efc-card tabindex=0><div class=efc-media><img src=https://borisfx-com-res.cloudinary.com/image/upload/w_1264,c_limit,q_auto,f_auto,fl_lossy/v1712410551/sapphire2024/4.jpg alt loading=lazy decoding=async></div><div class=efc-text><h3 class=efc-card-title>Stylize</h3><div class=efc-card-desc>A wide variety of ways to add high production value to any project.<br><br>Film effects, glitches, pixel sorts, vignettes, film grains, retro TV and film looks, kaleidos, auto-paints, and more.</div></div></div><div class=efc-card tabindex=0><div class=efc-media><img src=https://borisfx-com-res.cloudinary.com/image/upload/w_1264,c_limit,q_auto,f_auto,fl_lossy/v1712410619/sapphire2024/5.jpg alt loading=lazy decoding=async></div><div class=efc-text><h3 class=efc-card-title>Transition & Time</h3><div class=efc-card-desc>Auto-animating transitions from classic to modern and mind bending time effects.<br><br>Many custom dissolves and wipes, film rolls, hyper pulls, swish pans, feedback effects, time averaging, trails, and more.</div></div></div><div class=efc-card tabindex=0><div class=efc-media><img src=https://borisfx-com-res.cloudinary.com/image/upload/w_1264,c_limit,q_auto,f_auto,fl_lossy/v1712410620/sapphire2024/6.jpg alt loading=lazy decoding=async></div><div class=efc-text><h3 class=efc-card-title>Do virtually anything</h3><div class=efc-card-desc>Create cross-platform stacks of effects that apply as a single effect, or make entirely new effects and transitions with Sapphire Builder.<br><br>Endless possibilities!</div></div></div></div></div></section><section class=sapphire-effects-gallery><div class=seg-container><h2 class=seg-title>Effects showcase</h2><div class=seg-controls><div class=seg-category id=seg-category><button type=button class=seg-category-toggle aria-expanded=false aria-controls=seg-category-menu>
<span class=label id=seg-category-label>Category</span>
<span class=caret aria-hidden=true></span></button><div class=seg-category-menu id=seg-category-menu hidden role=group aria-label="Filter by category"></div></div><div class=seg-search-field><input id=seg-search-input type=search placeholder=Search autocomplete=off aria-label="Search effects">
<span class=seg-search-icon aria-hidden=true></span></div></div><div class=seg-grid id=seg-grid role=list></div><nav class=seg-pagination id=seg-pagination aria-label="Effects gallery pagination"></nav></div></section><script>(function(){function n(){return document.getElementById("seg-grid")&&document.getElementById("seg-pagination")}function e(){const r=document.querySelector(".sapphire-effects-gallery");if(!r||!n())return;if(r.dataset.initialized==="1")return;r.dataset.initialized="1";const v=[{title:"S_Aurora",video_id:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto/v1629401932/Marketing/Sapphire_ReDesign/EffectExamples/Aurora.mp4",poster:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto,f_auto,w_286,h_162/v1629401932/Marketing/Sapphire_ReDesign/EffectExamples/Aurora.png",tagging:{category:"Render"}},{title:"S_Beauty",video_id:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto/v1629401931/Marketing/Sapphire_ReDesign/EffectExamples/Beauty.mp4",poster:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto,f_auto,w_286,h_162/v1629401931/Marketing/Sapphire_ReDesign/EffectExamples/Beauty.png",tagging:{category:"Blur and Sharpen"}},{title:"S_Blur",video_id:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto/v1629401919/Marketing/Sapphire_ReDesign/EffectExamples/Blur.mp4",poster:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto,f_auto,w_286,h_162/v1629401919/Marketing/Sapphire_ReDesign/EffectExamples/Blur.png",tagging:{category:"Blur and Sharpen"}},{title:"S_BlurMoCurves",video_id:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto/v1629401932/Marketing/Sapphire_ReDesign/EffectExamples/BlurMoCurves.mp4",poster:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto,f_auto,w_286,h_162/v1629401932/Marketing/Sapphire_ReDesign/EffectExamples/BlurMoCurves.png",tagging:{category:"Blur and Sharpen"}},{title:"S_BlurMotion",video_id:"https://borisfx-com-res.cloudinary.com/video/upload/q_auto/v1629401919/Marketing