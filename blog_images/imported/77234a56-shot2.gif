\":[{\"categoryGroup\":\"CRIME\",\"id\":\"News\",\"type\":\"Category\"}],\"bypassModal\":false,\"cacheId\":\"74c7e57f-2004-37a4-9cf7-4e9b141c9cf2-1786460366031\",\"scoutQuestion\":{\"generatedAt\":\"2026-08-11T13:43:25.437397Z\",\"text\":\"How common are child exploitation charges in similar cases?\"},\"categoryLabel\":\"Celebrity\",\"commentCount\":202,\"contentType\":\"story\",\"duration\":\"$undefined\",\"generatedSummary\":\"$undefined\",\"id\":\"74c7e57f-2004-37a4-9cf7-4e9b141c9cf2\",\"instrumentation\":\"$undefined\",\"isHosted\":true,\"isLiveLabelSuppressed\":false,\"isPlutusStory\":\"$undefined\",\"liveBlog\":false,\"liveBlogId\":\"$undefined\",\"pubDate\":\"2026-08-11T03:28:13Z\",\"slides\":null,\"summary\":\"Rep. Lauren Boebert’s son Tyler Boebert’s ex-girlfriend showed cops a 43-second video he allegedly filmed of her before she turned 18 ... which led to his arrest for child sexual exploitation, TMZ has learned.  Per a criminal affidavit, 21-year-old Tyler, who was arrested on August 9, was charged with child sexual exploitation to induce or entice, possession with intent, sexual exploitation of a child, sexual exploitation of a child involving video, and two additional counts related to contributing to the delinquency of a minor.  The charges stem from an alleged video that a then-18-year-old Tyler filmed with his then-17-year-old girlfriend on April 1, 2024 ... a couple weeks before she reportedly turned 18.\",\"thumbnail\":{\"altText\":\"\",\"caption\":\"\",\"originalHeight\":315,\"originalUrl\":\"https://media.zenfs.com/en/tmz_articles_672/749a1c4a58de3d1f7e17de7a0167f342\",\"originalWidth\":420,\"resolutions\":[{\"__typename\":\"ImageResized\",\"height\":556,\"tag\":null,\"url\":\"https://s.yimg.com/lo/mysterio/api/70c0e23d7ca2dcc32c5a2ef2eed929209b3d9c120d4629edd14fd87b0e0f09d5/lightyear_networkapi/smartcrop_w1114_h556_faces%3Bquality_85%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Ftmz_articles_672%2F749a1c4a58de3d1f7e17de7a0167f342\",\"width