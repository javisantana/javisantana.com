/* --flexi-page-layout-- */
@layer legacy {
.widget-dynamic .more-link{
position: absolute;
top: 15px;
right: 0;
background-color: transparent;
color: #333;
width: 299px;
text-align:right;
}
.flexi-page.responsive .widget.widget-dynamic header .list-title{
text-align: center;
margin-bottom: 20px;
text-transform: uppercase;
line-height: 42px;
position: relative;
border-top: none;
border-bottom: 4px solid #006ea9;
}
.flexi-page.responsive .widget-area{
padding: 0;
}
#affiliate-disclaimer{
display: none;
}
.widget-dynamic .more-link i.fa{
filter: none;
}
@media screen and (max-width: 900px){
.flexi-page [class*=widget-] .widget-header,
.flexi-page.responsive .widget.widget-dynamic header .list-title {
text-align: left;
margin: 30px 0;
}
.listingResults{
margin-top: 20px;
}
.news.widget-dynamic .more-link{
margin: 20px 4px;
}
.widget-dynamic .more-link{
left: 0;
top: 63px;
margin: 20px 13px;
}
}
@media screen and (min-width: 900px){
#widgetArea1{
margin-left: 24px;
margin-right: 24px;
}
.tuition .listingResult.result1 {
width: 100% !important;
}
.flexi-page.responsive input[type=search]{
box-sizing: border-box;
}
.reviews .listingResult.result1 .content,.tuition .listingResult.result1 .content{
padding: 18px 28px 13px;
color: #fff;
width: 100%;
-webkit-box-sizing: border-box;
box-sizing: border-box;
background-color: rgba(51,51,51,.9);
position: absolute;
bottom: 0;
}
.news .listingResult.result6,.reviews .listingResult.result1,.tuition .listingResult.result1{
width: 100%;
}
.news .listingResult.result6 .content{
padding: 18px 28px 13px;
background-color: rgba(51,51,51,.9);
position: absolute;
bottom: 0;
width: 100%;
-webkit-box-sizing: border-box;
box-sizing: border-box;
}
.reviews .listingResult.result1 .rating{
float: none;
display: inline-block;
zoom: 1;
margin: 0 0 0 10px;
}
.reviews .listingResult.result1{
width: 100%;
}
.news .listingResult.result6 .content header,.reviews .listingResult.result1 .content header,.tuition .listingResult.result1 .content header{
margin-bottom: 6px;
}
.news .listingResult.result6 .content .article-name,.reviews .listingResult.result1 .content header .article-name,.tuition .listingResult.result1 .content header .article-name{
font-size: 28px;
line-height: 36px;
display: inline-block;
zoom: 1;
color: #fff;
font-weight: 400;
margin-bottom: 0;
}
.news .listingResult.result6 .content .byline,.reviews .listingResult.result1 .content .byline,.tuition .listingResult.result1 .content .byline{
display: none;
}
.news .listingResult.result6 .content .synopsis,.reviews .listingResult.result1 .content .synopsis,.tuition .listingResult.result1 .content .synopsis{
color: #fff;
}
.news .listingResult.result11, .news .listingResult.result12, .news .listingResult.result13, .news .listingResult.result14 {
width: 24% !important;
}
.flexi-page.impact .how-to .listingResult.result7 {
width: calc((100% - 30px) / 3);
}
.flexi-page.impact .reviews:not(.all) .listingResult.result7,
.flexi-page.impact .reviews:not(.all) .listingResult.result8,
.flexi-page.impact .reviews:not(.all) .listingResult.result9,
.flexi-page.impact .reviews:not(.all) .listingResult.result10,
.flexi-page.impact .news .listingResult.result9{
width: calc((100% - 30px) / 3);
}
}
}
</style>
