<script>
window.__fteSourcepointConsentConfig = {
accountId: 200,
baseEndpoint: "https:\/\/cdn.privacy-mgmt.com",
propertyId: null,
propertyHref: null,
};
</script>
<script>
(function () {
const CONFIG = window.__fteSourcepointConsentConfig ?? {};
const CONSENT_STORAGE_PREFIX = '_sp_user_consent_';
const LOG_BADGE = ['%c FTE ', 'background: #9306F9; color: #ffffff'];
const MAX_SHARD_RETRIES = 3;
const SHARD_RETRY_DELAY_MS = 250;
const safeJsonParse = (value) => {
if (typeof value !== 'string' || !value) return null;
try {
return JSON.parse(value);
} catch {
return null;
}
};
const safeJsonStringify = (value) => {
try {
return JSON.stringify(value ?? {});
} catch {
return '{}';
}
};
const safeDecode = (value) => {
try {
return decodeURIComponent(value);
} catch {
return value;
}
};
const getCookie = (name) => {
if (!document.cookie) return null;
const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const match = document.cookie.match(new RegExp(`(?:^|; )${escaped}=([^;]*)`));
return match ? safeDecode(match[1]) : null;
};
const getStorage = (key) => {
try {
return window.localStorage?.getItem(key) ?? null;
} catch {
return null;
}
};
const getPath = (source, path) =>
path.reduce((acc, key) => (acc && typeof acc === 'object' ? acc[key] : null), source) ??
null;
const normalizeBoolean = (value) => {
if (typeof value === 'boolean') return value;
if (value === 'true') return true;
if (value === 'false') return false;
return null;
};
const normalizeString = (value) => {
if (value === null || value === undefined) return '';
return String(value);
};
const isPresent = (value) => value !== null && value !== undefined && value !== '';
const firstPresent = (candidates) =>
candidates.find((c) => isPresent(c.value)) ?? { value: null, source: '' };
const getSourcepointStorage = () => {
const preferred = CONFIG.propertyId
? `${CONSENT_STORAGE_PREFIX}${CONFIG.propertyId}`
: null;
const candidateKeys = new Set(preferred ? [preferred] : []);
try {
const ls = window.localStorage;
if (ls) {
for (let i = 0; i < ls.length; i += 1) {
const key = ls.key(i);
if (key?.startsWith(CONSENT_STORAGE_PREFIX)) candidateKeys.add(key);
}
}
} catch {
/* localStorage blocked */
}
for (const key of candidateKeys) {
const parsed = safeJsonParse(getStorage(key));
if (parsed && typeof parsed === 'object') return { key, value: parsed };
}
return { key: null, value: {} };
};
const CONSENT_SCHEMA = {
gdpr: {
uuid: ({ storage, ctx }) => [
{
value: getPath(storage.value, ['gdpr', 'uuid']),
source: storage.key ? `${storage.key}.gdpr.uuid` : '',
},
{
value: ctx.messageType === 'gdpr' ? (ctx.consentUUID ?? null) : null,
source: 'onConsentReady.consentUUID',
},
{ value: getCookie('consentUUID'), source: 'cookie.consentUUID' },
],
consent_string: ({ storage, ctx }) => [
{
value: getPath(storage.value, ['gdpr', 'euconsent']),
source: storage.key ? `${storage.key}.gdpr.euconsent` : '',
},
{
value: ctx.messageType === 'gdpr' ? (ctx.euconsent ?? null) : null,
source: 'onConsentReady.euconsent',
},
{ value: getCookie('euconsent-v2'), source: 'cookie.euconsent-v2' },
],
applies: ({ storage, ctx }) => [
{
value: normalizeBoolean(getPath(storage.value, ['gdpr', 'applies'])),
source: storage.key ? `${storage.key}.gdpr.applies` : '',
},
{
value:
ctx.messageType === 'gdpr'
? normalizeBoolean(getPath(ctx.info, ['applies']))
: null,
source: 'onConsentReady.info.applies',
},
],
},
usnat: {
uuid: ({ storage, ctx }) => [
{
value: getPath(storage.value, ['usnat', 'uuid']),
source: storage.key ? `${storage.key}.usnat.uuid` : '',
},
{
value: ctx.messageType === 'usnat' ? (ctx.consentUUID ?? null) : null,
source: 'onConsentReady.consentUUID',
},
{ value: getCookie('usnatUUID'), source: 'cookie.usnatUUID' },
],
consent_string: ({ storage }) => [
{
value: getPath(storage.value, ['usnat', 'consentString']),
source: storage.key ? `${storage.key}.usnat.consentString` : '',
},
],
applies: ({ storage, ctx }) => [
{
value: normalizeBoolean(getPath(storage.value, ['usnat', 'applies'])),
source: storage.key ? `${storage.key}.usnat.applies` : '',
},
{
value:
ctx.messageType === 'usnat'
? normalizeBoolean(getPath(ctx.info, ['applies']))
: null,
source: 'onConsentReady.info.applies',
},
],
gpc_enabled: ({ storage }) => [
{
value: normalizeBoolean(getPath(storage.value, ['usnat', 'gpcEnabled'])),
source: storage.key ? `${storage.key}.usnat.gpcEnabled` : '',
},
],
},
};
const buildConsent = (fields, ctx, storage) =>
Object.entries(fields).reduce((consent, [name, candidatesFor]) => {
const winner = firstPresent(candidatesFor({ storage, ctx }));
if (winner.value === null) return consent;
return {
...consent,
[name]: winner.value,
...(winner.source ? { [`${name}_source`]: winner.source } : {}),
};
}, {});
const buildSourcepointMeta = () => {
const numericId = Number(CONFIG.propertyId);
return {
account_id: CONFIG.accountId,
property_href: CONFIG.propertyHref ?? '',
base_endpoint: CONFIG.baseEndpoint ?? '',
...(Number.isFinite(numericId) && CONFIG.propertyId !== null
? { property_id: numericId }
: {}),
};
};
const buildUserIds = () => {
const gaClientId = getCookie('_ga');
const hybridId = getPath(safeJsonParse(getStorage('permutive-data-misc')), [
'identities',
'hybridId',
'value',
]);
return [
isPresent(gaClientId) ? { type: 'TYPE_GA', value: gaClientId } : null,
isPresent(hybridId) ? { type: 'TYPE_HYBRID', value: hybridId } : null,
].filter(Boolean);
};
const buildPayload = (ctx) => {
const storage = getSourcepointStorage();
return {
event_id: `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`,
captured_at: new Date().toISOString(),
trigger: ctx.trigger,
message_type: ctx.messageType ?? '',
sourcepoint: buildSourcepointMeta(),
gdpr: buildConsent(CONSENT_SCHEMA.gdpr, ctx, storage),
usnat: buildConsent(CONSENT_SCHEMA.usnat, ctx, storage),
user_ids: buildUserIds(),
page: {
url: window.location.href,
hostname: window.location.hostname,
path: window.location.pathname,
referrer: document.referrer ?? '',
},
callback_data: {
choice_id: normalizeString(ctx.choiceId),
choice_type_id: normalizeString(ctx.choiceTypeId),
info_json: safeJsonStringify(ctx.info),
},
};
};
const hasShardedUuid = ({ gdpr, usnat }) =>
Boolean(gdpr?.uuid?.includes('_') || usnat?.uuid?.includes('_'));
const isFreyrEnabled = () => Boolean(window.vanilla?.featureFlags?.freyr?.enabled);
const ensureFreyrQueue = () => {
window.freyr = window.freyr || { cmd: [] };
if (!Array.isArray(window.freyr.cmd)) {
window.freyr.cmd = [];
}
};
const send = (payload) => {
if (!isFreyrEnabled()) {
console.warn(...LOG_BADGE, 'Sourcepoint consent event dropped: Freyr disabled');
return;
}
ensureFreyrQueue();
window.dispatchOrQueueAction('freyr.sendEventToFreyr', {
name: 'sourcepointConsentCapturedEvent',
eventObject: payload,
});
};
const captureAndSend = (ctx, attempt = 0) => {
const payload = buildPayload(ctx);
const shouldRetry =
ctx.trigger === 'CONSENT_EVENT_TRIGGER_ON_MESSAGE_CHOICE_SELECT' &&
attempt < MAX_SHARD_RETRIES &&
!hasShardedUuid(payload);
if (shouldRetry) {
window.setTimeout(() => captureAndSend(ctx, attempt + 1), SHARD_RETRY_DELAY_MS);
return;
}
send(payload);
};
window.fteSourcepointConsentEvent = {
captureAndSend: (ctx = {}) => {
try {
captureAndSend(ctx, 0);
} catch (error) {
console.warn(
...LOG_BADGE,
'Sourcepoint consent event failed',
error?.message ?? error,
);
}
},
};
})();
</script>
<script>
window._sp_queue = [];
window._sp_ = {
config: {
accountId: 200,
baseEndpoint: "https:\/\/cdn.privacy-mgmt.com",
usnat: {
includeUspApi: true
},
gdpr: {},
events: {
onMessageChoiceSelect: (messageType, choiceId, choiceTypeId) => {
window.setTimeout(() => {
window.fteSourcepointConsentEvent.captureAndSend({
trigger: 'CONSENT_EVENT_TRIGGER_ON_MESSAGE_CHOICE_SELECT',
messageType,
choiceId,
choiceTypeId,
});
}, 250);
window.dispatchOrQueueAction('freyr.sendEventToFreyr', {
name: 'cmpEvent',
eventObject: {
consentManagement: {
action: 'click',
data: { messageType, choiceId, choiceTypeId },
},
},
});
},
onMessageReady: (messageType) => {
window.dispatchOrQueueAction('freyr.sendEventToFreyr', {
name: 'cmpEvent',
eventObject: {
consentManagement: {
action: 'appear',
data: { messageType },
},
},
});
},
onMessageReceiveData: (messageType, data) => {
window.dispatchOrQueueAction('freyr.sendEventToFreyr', {
name: 'cmpModalInfo',
eventObject: {
cmpModalInfo: {
data: { messageType, ...data },
},
},
});
},
onPrivacyManagerActionStatus: (messageType, status, actionType) => {
window.dispatchOrQueueAction('freyr.sendEventToFreyr', {
name: 'cmpEvent',
eventObject: {
consentManagement: {
action: 'update',
data: { messageType, status, actionType },
},
},
});
},
onError: (...args) => {
console.error('%c FTE ', 'background: #9306F9; color: #ffffff', '[event] onError', args);
},
},
targetingParams: {
ecommerce_session: window.vanilla.getCookieByName('ecommerce_session') ?? 'false',
kiosqGranted: Boolean(
window.FUTR?.Connect?.isGranted ||
window.FUTR?.Kiosq?.User?.entitlements?.includes(
window.FUTR?.Kiosq?.defaultSiteConfig?.cb_porc_entitlement
)
),
articleType: "",
consent_or_pay_content: true,
sponsored: false,
},
},
};
</script>
